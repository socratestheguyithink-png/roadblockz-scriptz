-- Delay logic --------------------------------------------------------
local function setDelay(v)
    v = math.clamp(v, MIN_DELAY, MAX_DELAY)
    v = math.floor(v * 100 + 0.5) / 100
    delay = v
    box.Text = string.format("%.2f", v)
end

box.FocusLost:Connect(function()
    local n = tonumber(box.Text)
    setDelay(n or delay)
end)

minusBtn.Activated:Connect(function() setDelay(delay - 0.05) end)
plusBtn.Activated:Connect(function() setDelay(delay + 0.05) end)

toggle.Activated:Connect(function()
    enabled = not enabled
    if enabled then
        toggle.Text = "Effect: ON"
        toggle.BackgroundColor3 = Color3.fromRGB(40, 120, 80)
    else
        toggle.Text = "Effect: OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(140, 50, 50)
    end
end)

