local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

----------------------------------------------------------------------
-- Track-stepping core
----------------------------------------------------------------------
local orig = setmetatable({}, { __mode = "k" })      -- track -> speed the game wanted
local released = setmetatable({}, { __mode = "k" })  -- one-shot tracks we let finish
local animator
local lastTick = os.clock()

local function findAnimator()
    local char = LocalPlayer.Character
    if not char then
        animator = nil
        return
    end
    if animator and animator:IsDescendantOf(char) then
        return
    end
    animator = char:FindFirstChildWhichIsA("Animator", true)
end

-- Gives every frozen track its normal speed back
local function restoreAll()
    if next(orig) ~= nil then
        for track, speed in pairs(orig) do
            pcall(function()
                if track.Speed == 0 then
                    track:AdjustSpeed(speed)
                end
            end)
            orig[track] = nil
        end
    end
    if next(released) ~= nil then
        for track in pairs(released) do
            released[track] = nil
        end
    end
end

local function step()
    if not enabled or delay <= 0 then
        restoreAll()
        lastTick = os.clock()
        return
    end

    findAnimator()
    if not animator then return end

    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if not ok then return end

    -- Freeze every playing track (and catch speed changes made by the game)
    local seen = {}
    for _, track in ipairs(tracks) do
        seen[track] = true
        if not released[track] then
            local s = track.Speed
            if s ~= 0 then
                orig[track] = s
                track:AdjustSpeed(0)
            end
        end
    end

    -- Tracks that stopped: hand their speed back so replays behave normally
    for track, speed in pairs(orig) do
        if not seen[track] then
            pcall(function()
                if track.Speed == 0 then
                    track:AdjustSpeed(speed)
                end
            end)
            orig[track] = nil
        end
    end
    for track in pairs(released) do
        if not seen[track] then
            released[track] = nil
        end
    end

    -- Every `delay` seconds, jump the frozen tracks to the current time
    local now = os.clock()
    local elapsed = now - lastTick
    if elapsed < delay then return end
    lastTick = now

    for track, speed in pairs(orig) do
        local len = track.Length
        if len > 0 and track.IsPlaying then
            local t = track.TimePosition + elapsed * speed
            if track.Looped then
                track.TimePosition = t % len
            elseif t >= len or t < 0 then
                -- one-shot animation reached its end: let it finish normally
                track.TimePosition = math.clamp(t, 0, len)
                track:AdjustSpeed(speed)
                orig[track] = nil
                released[track] = true
            else
                track.TimePosition = t
            end
        end
    end
end

connect(RunService.Heartbeat, step)

