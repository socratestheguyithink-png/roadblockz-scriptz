local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

local function corner(parent, radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness,
        Transparency = transparency,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

-- Works with mouse and touch. If the pointer barely moves, it counts as a click.
local function makeDraggable(handle, target, onClick)
    local activeInput, dragStart, startPos, moved

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeInput = input
            moved = false
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = target.AbsolutePosition
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End and activeInput == input then
                    activeInput = nil
                    if not moved and onClick then
                        onClick()
                    end
                end
            end)
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if not activeInput then return end
        local isMove
        if activeInput.UserInputType == Enum.UserInputType.Touch then
            isMove = (input == activeInput)
        else
            isMove = (input.UserInputType == Enum.UserInputType.MouseMovement)
        end
        if not isMove then return end

        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        if delta.Magnitude > 6 then
            moved = true
        end
        if moved then
            local screen = gui.AbsoluteSize
            local size = target.AbsoluteSize
            local x = math.clamp(startPos.X + delta.X, 0, math.max(0, screen.X - size.X))
            local y = math.clamp(startPos.Y + delta.Y, 0, math.max(0, screen.Y - size.Y))
            target.Position = UDim2.fromOffset(x, y)
        end
    end)
end

local function mountGui(g)
    local ok = pcall(function()
        g.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not ok or not g.Parent then
        g.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

