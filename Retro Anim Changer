----------------------------------------------------------------------
-- Cleanup (used when the script is re-executed)
----------------------------------------------------------------------
env.RetroAnimChangerCleanup = function()
    restoreAll() -- give frozen tracks their speed back
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    if gui then
        gui:Destroy()
    end
    env.RetroAnimChangerCleanup = nil
end

